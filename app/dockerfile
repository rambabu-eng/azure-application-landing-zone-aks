FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .
COPY constraints.txt .

RUN python -m pip install --no-cache-dir --upgrade pip setuptools && \
    python -m pip install --no-cache-dir \
      -r requirements.txt \
      -c constraints.txt

COPY app.py .

EXPOSE 8080

CMD ["gunicorn", "--bind", "0.0.0.0:8080", "app:app"]